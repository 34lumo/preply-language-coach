{
  "version": 2,
  "buildCommand": "cd frontend/frontend && npm ci --legacy-peer-deps && npm run build",
  "outputDirectory": "frontend/frontend/dist",
  "functions": {
    "main.py": {
      "runtime": "python3.12",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/main.py" },
    { "source": "/((?!assets|frames|favicon|preply).*)", "destination": "/index.html" }
  ]
}
